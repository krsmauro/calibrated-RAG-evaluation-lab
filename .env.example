# Copy to .env (gitignored). `make up` does this for you if .env is missing.
# These are LOCAL DEVELOPMENT values: the database listens on 127.0.0.1 only.
# Never put real API keys in this file; keys belong in your own .env.

# Postgres container (docker-compose.yml)
POSTGRES_USER=ragcalibrate
POSTGRES_PASSWORD=ragcalibrate
POSTGRES_DB=ragcalibrate

# Host port for Postgres. 5433 so it does not clash with a Postgres you already run.
RAGCALIBRATE_DB_PORT=5433

# Application settings (ragcalibrate/config.py). Must match the Postgres values above.
RAGCALIBRATE_DATABASE_URL=postgresql://ragcalibrate:ragcalibrate@127.0.0.1:5433/ragcalibrate
